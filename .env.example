# Copy to .env and fill in. The app fails loudly at boot if a required
# variable is missing or malformed — see apps/web/lib/env.ts.

# --- Required from stage 1 ---
# NODE_ENV is not set here — Next.js, Vitest, etc. each set it themselves
# for the command being run (development/production/test).
DATABASE_URL=postgresql://insurix:insurix@localhost:5432/insurix

# --- Added in later build stages (not yet read by any app code) ---
# Object storage (MinIO locally, S3-compatible in prod) — stage 5 (upload pipeline)
# S3_ENDPOINT=http://localhost:9000
# S3_REGION=us-east-1
# S3_BUCKET=insurix-documents
# S3_ACCESS_KEY_ID=insurix
# S3_SECRET_ACCESS_KEY=insurix-local-dev

# Auth.js — stage 5
# AUTH_SECRET=
# AUTH_GOOGLE_ID=
# AUTH_GOOGLE_SECRET=
# EMAIL_SERVER=
# EMAIL_FROM=

# Anthropic — stage 6 (AI extraction layer)
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=
# AI_DAILY_SPEND_CAP_PAISE=
